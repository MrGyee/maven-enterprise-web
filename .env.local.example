# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed.

# Admin dashboard login. Email is matched case-insensitively.
ADMIN_EMAIL=admin@mavenenterprise.co.ke
ADMIN_PASSWORD=change-this-password

# Secret used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Supabase project (Settings -> API in the Supabase dashboard). The
# service_role key is server-only — never expose it to the client, never
# prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Cloudinary (Dashboard home page shows all three).
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret

# Analytics (both optional — leave unset to ship with no tracking at all).
# NEXT_PUBLIC_ vars are inlined into the client bundle at build time, so a
# rebuild/redeploy is needed after changing either one.
# GA4: Admin -> Data Streams -> your web stream -> Measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta: Events Manager -> Data Sources -> your Pixel -> Pixel ID.
NEXT_PUBLIC_META_PIXEL_ID=
