# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed.

# Admin dashboard login (Phase 2 local CMS auth — replace with Supabase Auth
# in Phase 3). Email is matched case-insensitively.
ADMIN_EMAIL=admin@mavenenterprise.co.ke
ADMIN_PASSWORD=change-this-password

# Secret used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string
